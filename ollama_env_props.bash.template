# This machine's own differences from ollama_common.bash (which every machine shares, and git updates).
# Most machines don't need this file at all: both cameras use the same Ollama server and the same
# question, so they classify alike. Copy this to ollama_env_props.bash (not tracked by git) only if this
# machine must differ, and set just what differs. It is sourced at the end of ollama_common.bash.
#
# For example, a test machine with its own Ollama:
# api="http://localhost:11434"
#
# or the private test clips checked out somewhere other than next to this repo:
# cmo_test_data="/data/cmo_test_data"
#
# or a test cmo_server for both cameras on this machine:
# cmo_server="http://192.168.1.167:9090/"
